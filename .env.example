# Settings for docker compose and the VS Code debugger. Edit .env (a copy of
# this file is included); docker compose reads it automatically.

# Folder on this computer to scan for photos. Docker mounts it read-only at
# /photos in the API container; the VS Code debugger reads it from here too.
# Use a full path. Leave it commented out to use the sample ./photos folder.
#
# After changing it, run:  docker compose up -d
#
# PHOTOS_DIR=/Users/yourname/Pictures
# PHOTOS_DIR=C:/Users/yourname/Pictures

# Port for the web app: http://localhost:3000
WEB_PORT=3000

# Host port for MongoDB (bound to localhost only).
MONGO_PORT=27017
